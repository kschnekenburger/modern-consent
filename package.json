{
  "name": "modernconsent",
  "version": "1.0.0",
  "description": "A modern, lightweight cookie consent library",
  "private": true,
  "type": "module",
  "author": "ModernConsent Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kschnekenburger/modern-consent"
  },
  "homepage": "https://github.com/kschnekenburger/modern-consent#readme",
  "bugs": {
    "url": "https://github.com/kschnekenburger/modern-consent/issues"
  },
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.2.5"
    }
  }
}
