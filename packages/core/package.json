{
  "name": "@modernconsent/core",
  "version": "3.0.0",
  "description": "A modern, lightweight consent management library",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./resolver": {
      "types": "./dist/resolver.d.ts",
      "import": "./dist/resolver.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/index.js"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitest/ui": "^4.0.16",
    "jsdom": "^27.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.16"
  },
  "license": "MIT",
  "author": "ModernConsent Contributors",
  "keywords": [
    "consent",
    "gdpr",
    "rgpd",
    "cookie",
    "cmp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kschnekenburger/modern-consent",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/kschnekenburger/modern-consent#readme",
  "bugs": {
    "url": "https://github.com/kschnekenburger/modern-consent/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
