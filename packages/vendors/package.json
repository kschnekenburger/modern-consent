{
  "name": "@modernconsent/vendors",
  "version": "2.0.0",
  "description": "Built-in vendor implementations for ModernConsent",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@modernconsent/core": ">=2.0.0"
  },
  "devDependencies": {
    "@modernconsent/core": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "license": "MIT",
  "author": "ModernConsent Contributors",
  "keywords": [
    "consent",
    "gdpr",
    "rgpd",
    "cookie",
    "vendor",
    "google-analytics",
    "meta-pixel"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kschnekenburger/modern-consent",
    "directory": "packages/vendors"
  },
  "homepage": "https://github.com/kschnekenburger/modern-consent#readme",
  "bugs": {
    "url": "https://github.com/kschnekenburger/modern-consent/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
